{
  "name": "hash-sentinel",
  "version": "1.1.0",
  "description": "Hash lookup CLI: hash files or take MD5/SHA1/SHA256/SHA512 values and check them offline against self-hosted feeds (hash lists, CSV, MISP events and MISP feed directories, cached URL feeds) and optionally CIRCL hashlookup (no key), MalwareBazaar or VirusTotal. Zero deps.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hash-sentinel": "bin/hash-sentinel.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hash",
    "hash-lookup",
    "malware",
    "ioc",
    "threat-intelligence",
    "misp",
    "malwarebazaar",
    "circl",
    "hashlookup",
    "nsrl",
    "virustotal",
    "dfir",
    "incident-response",
    "sha256",
    "security",
    "sarif",
    "cli",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/hash-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/hash-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/hash-sentinel/",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
